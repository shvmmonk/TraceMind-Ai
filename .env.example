# Leave both keys blank for offline deterministic mode. Set ONE key only if desired.
# Never commit real credentials or paste them into chat.
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
# Cloud platforms provide PORT automatically. Local uses 8000.
PORT=8000
# Set PUBLIC_DEMO=1 ONLY on an isolated disposable hackathon demo, not a real service.
PUBLIC_DEMO=0
